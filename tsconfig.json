{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "agent/penpot-sync/src/**/*.ts",
    "agent/penpot-sync/test/**/*.ts",
    "agent/design-control/src/**/*.ts",
    "agent/design-control/test/**/*.ts",
    "vitest.config.ts"
  ]
}
