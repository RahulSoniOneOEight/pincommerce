{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Client Integration Map",
  "type": "object",
  "required": ["client_id","integrations"],
  "properties": {
    "client_id":{"type":"string","minLength":1},
    "integrations":{
      "type":"array",
      "items":{
        "type":"object",
        "required":["id","domain","provider_candidates","direction","criticality","data_classes","fallback_strategy"],
        "properties":{
          "id":{"type":"string"},
          "domain":{"type":"string"},
          "provider_candidates":{"type":"array","items":{"type":"string"},"minItems":1},
          "direction":{"enum":["inbound","outbound","bidirectional"]},
          "criticality":{"enum":["low","medium","high","critical"]},
          "data_classes":{"type":"array","items":{"type":"string"}},
          "credential_refs":{"type":"array","items":{"type":"string"}},
          "sla":{"type":"object","additionalProperties":true},
          "fallback_strategy":{"type":"string"},
          "events":{"type":"array","items":{"type":"string"}},
          "commands":{"type":"array","items":{"type":"string"}}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
