{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Approved Scope Baseline",
  "type": "object",
  "required": [
    "baseline_id",
    "client_id",
    "version",
    "solution_ref",
    "experience_ref",
    "review_ref",
    "visual_qa_refs",
    "included_capabilities",
    "excluded_capabilities",
    "deferred_capabilities",
    "architecture_decisions",
    "approved_by",
    "approved_at",
    "immutable"
  ],
  "properties": {
    "baseline_id": {
      "type": "string",
      "pattern": "^BASE-[A-Za-z0-9._-]+$"
    },
    "client_id": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "solution_ref": {
      "type": "string"
    },
    "experience_ref": {
      "type": "string"
    },
    "review_ref": {
      "type": "string"
    },
    "visual_qa_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "included_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "excluded_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deferred_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "architecture_decisions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "open_non_blocking_items": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approved_by": {
      "type": "string",
      "minLength": 1
    },
    "approved_at": {
      "type": "string",
      "minLength": 1
    },
    "immutable": {
      "const": true
    },
    "live_review_sessions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "truth_ref": {
      "type": "string"
    },
    "prototype_coverage_ref": {
      "type": "string"
    },
    "prototype_implementation_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "core_runtime_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "demo_dataset_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "build_id": {
      "type": "string"
    },
    "approved_surfaces": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approved_journeys": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
