{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Production QA",
  "type":"object",
  "required":["qa_id","client_id","scope_ref","production_execution_ref","checks","evidence_refs","blocking_items","status"],
  "properties":{
    "qa_id":{"type":"string","pattern":"^PRODQA-[A-Za-z0-9._-]+$"},
    "client_id":{"type":"string","minLength":1},
    "scope_ref":{"type":"string","const":"approved/current-scope.yaml"},
    "production_execution_ref":{"type":"string","minLength":1},
    "checks":{
      "type":"object",
      "minProperties":1,
      "additionalProperties":{"enum":["pass","fail"]}
    },
    "evidence_refs":{"type":"array","minItems":1,"items":{"type":"string"}},
    "blocking_items":{"type":"array","items":{"type":"string"}},
    "status":{"enum":["passed","failed"]}
  },
  "additionalProperties":false
}
