{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "client_id",
    "surfaces",
    "journeys",
    "components",
    "status"
  ],
  "properties": {
    "client_id": {
      "type": "string"
    },
    "surfaces": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "journeys": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "nodes"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "nodes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "surface",
                "component_refs",
                "state_refs"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "surface": {
                  "type": "string"
                },
                "component_refs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "state_refs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "generated",
        "review-ready",
        "approved"
      ]
    }
  },
  "additionalProperties": false
}
