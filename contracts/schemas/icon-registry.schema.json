{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Icon Registry",
  "type": "object",
  "required": [
    "policy",
    "icons",
    "status"
  ],
  "properties": {
    "policy": {
      "type": "object",
      "required": [
        "primary",
        "secondary",
        "fallback"
      ]
    },
    "icons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "semantic_id",
          "family",
          "name",
          "weight",
          "size",
          "flutter",
          "web",
          "penpot"
        ]
      }
    },
    "status": {
      "enum": [
        "draft",
        "review-ready",
        "approved"
      ]
    }
  },
  "additionalProperties": true
}