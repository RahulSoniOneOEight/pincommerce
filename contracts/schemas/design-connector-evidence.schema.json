{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "client_id",
    "sources"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "client_id": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "mode",
          "status",
          "provenance_ref"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "enum": [
              "figma",
              "penpot",
              "git",
              "reference-site",
              "brand-guide",
              "client-media"
            ]
          },
          "mode": {
            "enum": [
              "live",
              "export",
              "fixture"
            ]
          },
          "status": {
            "enum": [
              "ready",
              "unavailable",
              "failed"
            ]
          },
          "provenance_ref": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        }
      }
    }
  }
}
