{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Provider Sandbox Evidence",
  "type":"object",
  "required":["evidence_id","candidate_id","providers","status"],
  "properties":{
    "evidence_id":{"type":"string","pattern":"^PROVSTG-[A-Za-z0-9._-]+$"},
    "candidate_id":{"type":"string","minLength":1},
    "providers":{"type":"array","minItems":1,"items":{
      "type":"object",
      "required":["id","mode","credential_ref","status","evidence"],
      "properties":{
        "id":{"type":"string","minLength":1},
        "mode":{"enum":["sandbox","staging","live"]},
        "credential_ref":{"type":"string","minLength":1},
        "status":{"enum":["pass","fail","not-run"]},
        "evidence":{"type":"string"}
      },
      "additionalProperties":false
    }},
    "status":{"enum":["passed","failed","blocked"]}
  },
  "additionalProperties":false
}
