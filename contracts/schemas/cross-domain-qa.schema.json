{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Cross Domain QA",
  "type":"object",
  "required":["qa_id","client_id","production_execution_ref","cases","blocking_items","status"],
  "properties":{
    "qa_id":{"type":"string","pattern":"^CDQA-[A-Za-z0-9._-]+$"},
    "client_id":{"type":"string","minLength":1},
    "production_execution_ref":{"type":"string","minLength":1},
    "cases":{"type":"array","minItems":1,"items":{
      "type":"object",
      "required":["id","journey","domains","checks","evidence_refs","status"],
      "properties":{
        "id":{"type":"string","minLength":1},
        "journey":{"type":"string","minLength":1},
        "domains":{"type":"array","minItems":2,"items":{"type":"string"}},
        "checks":{"type":"array","minItems":1,"items":{"type":"string"}},
        "evidence_refs":{"type":"array","minItems":1,"items":{"type":"string"}},
        "status":{"enum":["pass","fail"]}
      },
      "additionalProperties":false
    }},
    "blocking_items":{"type":"array","items":{"type":"string"}},
    "status":{"enum":["passed","failed"]}
  },
  "additionalProperties":false
}
