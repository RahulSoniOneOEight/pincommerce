{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Design Outcome",
  "type":"object",
  "required":["outcome_id","client_id","target","decision","feedback","status"],
  "properties":{
    "outcome_id":{"type":"string"},
    "client_id":{"type":"string"},
    "target":{"type":"string"},
    "decision":{"enum":["accepted","accepted-with-changes","rejected","unknown"]},
    "feedback":{"type":"array","items":{"type":"string"}},
    "production_metrics":{"type":"object"},
    "status":{"enum":["draft","recorded","closed"]}
  },
  "additionalProperties":true
}
