{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Production Execution",
  "type":"object",
  "required":["execution_id","client_id","production_plan_ref","production_readiness_ref","runtimes","provider_bindings","migration","integration","blocking_items","status"],
  "properties":{
    "execution_id":{"type":"string","pattern":"^PRODEXEC-[A-Za-z0-9._-]+$"},
    "client_id":{"type":"string","minLength":1},
    "production_plan_ref":{"type":"string","minLength":1},
    "production_readiness_ref":{"type":"string","minLength":1},
    "runtimes":{"type":"array","minItems":1,"items":{
      "type":"object",
      "required":["domain","provider","version","provisioning","healthcheck","evidence_ref","status"],
      "properties":{
        "domain":{"type":"string","minLength":1},
        "provider":{"type":"string","minLength":1},
        "version":{"type":"string","minLength":1},
        "provisioning":{"enum":["container","project-runtime","managed-or-container","application-build"]},
        "healthcheck":{"type":"string","minLength":1},
        "evidence_ref":{"type":"string","minLength":1},
        "status":{"enum":["validated","blocked"]}
      },
      "additionalProperties":false
    }},
    "provider_bindings":{"type":"array","items":{
      "type":"object",
      "required":["integration_id","provider","adapter_ref","credential_refs","verification","staging_live_verification","status"],
      "properties":{
        "integration_id":{"type":"string","minLength":1},
        "provider":{"type":"string","minLength":1},
        "adapter_ref":{"type":"string","minLength":1},
        "credential_refs":{"type":"array","minItems":1,"items":{"type":"string"}},
        "verification":{"enum":["contract-tested","live-tested"]},
        "staging_live_verification":{"type":"boolean"},
        "status":{"enum":["configured","blocked"]}
      },
      "additionalProperties":false
    }},
    "migration":{
      "type":"object",
      "required":["plan_ref","demo_data_replaced","master_data_strategy_validated","opening_inventory_strategy_validated","opening_finance_strategy_validated","evidence_ref","status"],
      "properties":{
        "plan_ref":{"type":"string","minLength":1},
        "demo_data_replaced":{"type":"boolean"},
        "master_data_strategy_validated":{"type":"boolean"},
        "opening_inventory_strategy_validated":{"type":"boolean"},
        "opening_finance_strategy_validated":{"type":"boolean"},
        "evidence_ref":{"type":"string","minLength":1},
        "status":{"enum":["validated","blocked"]}
      },
      "additionalProperties":false
    },
    "integration":{
      "type":"object",
      "required":["event_bus","durable_store","idempotency","retry","dead_letter","reconciliation","evidence_refs","status"],
      "properties":{
        "event_bus":{"type":"string","minLength":1},
        "durable_store":{"type":"string","minLength":1},
        "idempotency":{"type":"boolean"},
        "retry":{"type":"boolean"},
        "dead_letter":{"type":"boolean"},
        "reconciliation":{"type":"boolean"},
        "evidence_refs":{"type":"array","minItems":1,"items":{"type":"string"}},
        "status":{"enum":["validated","blocked"]}
      },
      "additionalProperties":false
    },
    "blocking_items":{"type":"array","items":{"type":"string"}},
    "status":{"enum":["blocked","productionized"]}
  },
  "additionalProperties":false
}
