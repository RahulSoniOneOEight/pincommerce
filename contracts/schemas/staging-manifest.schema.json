{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Staging Manifest",
  "type":"object",
  "required":["manifest_id","client_id","candidate_id","candidate_digest","source_revision","runtimes","data_imports","e2e_flows","provider_checks","status"],
  "properties":{
    "manifest_id":{"type":"string","pattern":"^STGMAN-[A-Za-z0-9._-]+$"},
    "client_id":{"type":"string","minLength":1},
    "candidate_id":{"type":"string","minLength":1},
    "candidate_digest":{"type":"string","minLength":1},
    "source_revision":{"type":"string","minLength":7},
    "runtimes":{"type":"array","minItems":1,"items":{
      "type":"object",
      "required":["id","provider","version","required","healthcheck"],
      "properties":{
        "id":{"type":"string","minLength":1},
        "provider":{"type":"string","minLength":1},
        "version":{"type":"string","minLength":1},
        "required":{"type":"boolean"},
        "healthcheck":{"type":"string","minLength":1}
      },
      "additionalProperties":false
    }},
    "data_imports":{"type":"array","minItems":1,"items":{
      "type":"object",
      "required":["id","target","required","readback"],
      "properties":{
        "id":{"type":"string","minLength":1},
        "target":{"type":"string","minLength":1},
        "required":{"type":"boolean"},
        "readback":{"type":"string","minLength":1}
      },
      "additionalProperties":false
    }},
    "e2e_flows":{"type":"array","minItems":1,"items":{"type":"string"}},
    "provider_checks":{"type":"array","items":{"type":"string"}},
    "status":{"enum":["planned","running","validated","blocked"]}
  },
  "additionalProperties":false
}
