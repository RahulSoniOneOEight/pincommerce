{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "client_id",
    "journeys",
    "status"
  ],
  "properties": {
    "client_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "generated",
        "review-ready",
        "approved"
      ]
    },
    "journeys": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "actor",
          "surfaces",
          "nodes"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "actor": {
            "type": "string"
          },
          "surfaces": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "nodes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "action",
                "success_state",
                "error_state"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "action": {
                  "type": "string"
                },
                "surface": {
                  "type": "string"
                },
                "capability": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "success_state": {
                  "type": "string"
                },
                "error_state": {
                  "type": "string"
                },
                "empty_state": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "permission": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "event": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "next": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}