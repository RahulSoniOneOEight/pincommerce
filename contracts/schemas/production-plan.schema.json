{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Production Plan",
  "type":"object",
  "required":["production_plan_id","client_id","scope","source","capabilities","surfaces","runtimes","integrations","data","configuration","acceptance","blocking_items","status"],
  "properties":{
    "production_plan_id":{"type":"string","pattern":"^PRODPLAN-[A-Za-z0-9._-]+$"},
    "client_id":{"type":"string","minLength":1},
    "scope":{
      "type":"object",
      "required":["current_scope_ref","baseline_ref","baseline_id","version"],
      "properties":{
        "current_scope_ref":{"type":"string","const":"approved/current-scope.yaml"},
        "baseline_ref":{"type":"string","minLength":1},
        "baseline_id":{"type":"string","minLength":1},
        "version":{"type":"integer","minimum":1}
      },
      "additionalProperties":false
    },
    "source":{
      "type":"object",
      "required":["solution_ref","business_contract_ref","data_contract_ref","architecture_decision_refs"],
      "properties":{
        "solution_ref":{"type":"string","minLength":1},
        "business_contract_ref":{"type":"string","minLength":1},
        "data_contract_ref":{"type":"string","minLength":1},
        "prototype_revision_ref":{"type":["string","null"]},
        "review_round_ref":{"type":["string","null"]},
        "architecture_decision_refs":{"type":"array","items":{"type":"string"}}
      },
      "additionalProperties":false
    },
    "capabilities":{"type":"array","minItems":1,"items":{
      "type":"object",
      "required":["id","owner","disposition","source"],
      "properties":{
        "id":{"type":"string","minLength":1},
        "owner":{"type":"string","minLength":1},
        "disposition":{"enum":["standard","approved-overlay","blocked"]},
        "source":{"type":"string","minLength":1},
        "notes":{"type":"array","items":{"type":"string"}}
      },
      "additionalProperties":false
    }},
    "surfaces":{"type":"array","minItems":1,"items":{
      "type":"object",
      "required":["surface","provider","production_target","status"],
      "properties":{
        "surface":{"type":"string","minLength":1},
        "provider":{"type":["string","null"]},
        "production_target":{"type":"string","minLength":1},
        "status":{"enum":["mapped","blocked"]}
      },
      "additionalProperties":false
    }},
    "runtimes":{"type":"array","items":{
      "type":"object",
      "required":["domain","provider","required","production_mode","adapter_ref","baseline_ref","status"],
      "properties":{
        "domain":{"type":"string","minLength":1},
        "provider":{"type":"string","minLength":1},
        "required":{"type":"boolean"},
        "production_mode":{"enum":["real","not-required"]},
        "adapter_ref":{"type":["string","null"]},
        "baseline_ref":{"type":["string","null"]},
        "version":{"type":["string","null"]},
        "overlays":{"type":"array","items":{"type":"string"}},
        "status":{"enum":["mapped","blocked","not-required"]}
      },
      "additionalProperties":false
    }},
    "integrations":{"type":"array","items":{
      "type":"object",
      "required":["integration_id","domain","provider_candidates","selected_provider","selection_status","production_mode","credential_refs","adapter_ref","reconciliation_required","status"],
      "properties":{
        "integration_id":{"type":"string","minLength":1},
        "domain":{"type":"string","minLength":1},
        "provider_candidates":{"type":"array","items":{"type":"string"},"minItems":1},
        "selected_provider":{"type":["string","null"]},
        "selection_status":{"enum":["resolved","selection-required"]},
        "production_mode":{"enum":["live","unresolved"]},
        "credential_refs":{"type":"array","items":{"type":"string"}},
        "adapter_ref":{"type":["string","null"]},
        "reconciliation_required":{"type":"boolean"},
        "status":{"enum":["mapped","blocked"]}
      },
      "additionalProperties":false
    }},
    "data":{
      "type":"object",
      "required":["demo_data_action","master_data_action","opening_inventory_action","opening_finance_action","entity_ownership"],
      "properties":{
        "demo_data_action":{"enum":["replace"]},
        "master_data_action":{"enum":["migrate","load","not-required"]},
        "opening_inventory_action":{"enum":["load","not-required"]},
        "opening_finance_action":{"enum":["load","not-required"]},
        "entity_ownership":{"type":"array","items":{
          "type":"object",
          "required":["entity","owner","consumers"],
          "properties":{
            "entity":{"type":"string"},
            "owner":{"type":"string"},
            "consumers":{"type":"array","items":{"type":"string"}}
          },
          "additionalProperties":false
        }}
      },
      "additionalProperties":false
    },
    "configuration":{
      "type":"object",
      "required":["strategy","approved_overlays","deferred_capabilities","excluded_capabilities"],
      "properties":{
        "strategy":{"const":"standard-baseline-plus-approved-overlays"},
        "approved_overlays":{"type":"array","items":{"type":"string"}},
        "deferred_capabilities":{"type":"array","items":{"type":"string"}},
        "excluded_capabilities":{"type":"array","items":{"type":"string"}}
      },
      "additionalProperties":false
    },
    "acceptance":{
      "type":"object",
      "required":["required_checks"],
      "properties":{
        "required_checks":{"type":"array","minItems":1,"items":{"type":"string"}}
      },
      "additionalProperties":false
    },
    "blocking_items":{"type":"array","items":{"type":"string"}},
    "status":{"enum":["draft","blocked","production-ready"]}
  },
  "additionalProperties":false
}
