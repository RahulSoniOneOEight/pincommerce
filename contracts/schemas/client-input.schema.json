{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Client Input",
  "type": "object",
  "required": [
    "client_id",
    "industry",
    "business_models"
  ],
  "properties": {
    "client_id": {
      "type": "string",
      "minLength": 1
    },
    "client_name": {
      "type": "string"
    },
    "industry": {
      "type": "string",
      "minLength": 1
    },
    "business_models": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "goals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requested_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "required_integrations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "existing_systems": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "required": [
              "name",
              "category"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "category": {
                "type": "string"
              },
              "owner": {
                "type": "string"
              },
              "criticality": {
                "enum": [
                  "low",
                  "medium",
                  "high",
                  "critical"
                ]
              },
              "notes": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        ]
      }
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "volumes": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "number",
          "integer",
          "string"
        ]
      }
    },
    "stakeholders": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "role"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "approval_scope": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "compliance": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "geographies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risk_profile": {
      "type": "string"
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "submitted_by": {
      "type": "string"
    },
    "submitted_at": {
      "type": "string"
    },
    "experience_requirements": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "required": [
              "statement"
            ],
            "properties": {
              "requirement_id": {
                "type": "string",
                "pattern": "^REQ-[A-Za-z0-9._-]+$"
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "ux_impact": {
                "type": "boolean"
              },
              "source_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "requested_surfaces": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "requested_screens": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "requested_components": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "required_states": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "decision": {
                "enum": [
                  "deferred",
                  "not-applicable"
                ]
              },
              "decision_reason": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        ]
      }
    },
    "core_module_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "module",
          "change"
        ],
        "properties": {
          "requirement_id": {
            "type": "string",
            "pattern": "^REQ-[A-Za-z0-9._-]+$"
          },
          "module": {
            "enum": [
              "medusa",
              "mercur",
              "tryton"
            ]
          },
          "target": {
            "type": "string"
          },
          "change": {
            "type": "string",
            "minLength": 1
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "marketplace_requirements": {
      "type": "object",
      "properties": {
        "seller_onboarding": {
          "type": "string"
        },
        "seller_kyc": {
          "type": "string"
        },
        "catalogue_ownership": {
          "type": "string"
        },
        "inventory_ownership": {
          "type": "string"
        },
        "fulfilment_ownership": {
          "type": "string"
        },
        "returns_ownership": {
          "type": "string"
        },
        "commission_model": {
          "type": "string"
        },
        "settlement_cycle": {
          "type": "string"
        },
        "payout_model": {
          "type": "string"
        },
        "dispute_model": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "design_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "ref"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "enum": [
              "existing-app",
              "existing-web",
              "git",
              "figma",
              "penpot",
              "brand-guide",
              "reference-site",
              "client-media",
              "other"
            ]
          },
          "ref": {
            "type": "string"
          },
          "authority": {
            "enum": [
              "client-authoritative",
              "approved-reference",
              "advisory"
            ]
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "brand": {
      "type": "object",
      "properties": {
        "tone": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fonts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "raw_colors": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "semantic_overrides": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "image_direction": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "motion_preference": {
          "enum": [
            "reduced",
            "restrained",
            "balanced",
            "expressive"
          ]
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
