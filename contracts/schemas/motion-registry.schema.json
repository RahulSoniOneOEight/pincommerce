{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Motion Registry",
  "type": "object",
  "required": [
    "motions",
    "status"
  ],
  "properties": {
    "motions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "semantic_id",
          "trigger",
          "effect",
          "duration_ms",
          "curve",
          "flutter",
          "web"
        ]
      }
    },
    "status": {
      "enum": [
        "draft",
        "review-ready",
        "approved"
      ]
    }
  },
  "additionalProperties": true
}